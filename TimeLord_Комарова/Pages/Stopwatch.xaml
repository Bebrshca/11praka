<Page x:Class="TimeLord_Комарова.Pages.Stopwatch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TimeLord_Комарова.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Stopwatch">

    <Grid Background="#FFE8E100">
        <ListView x:Name="lv_Intervals" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="200" Height="100" Margin="547,0,0,28"/>
        <Label x:Name="time" Content="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="299, 95, 299, 242.6" Foreground="White" FontSize="48"/>
        <Button x:Name="start" Click="StartStopwatch" Content="Начать" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="280, 312, 402.4, 72.6" Width="100" Height="25" Background="White" Foreground="#FFE8E100"/>
        <Button Content="Интервал" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="410, 312, 272, 72.6" Width="100" Height="25" Background="White" Foreground="#FFE8E100"/>
        <Button Content="Интервал" Click="AddInterval" HorizontalAlignment="Left" Margin="115,372,0,0" VerticalAlignment="Top" Width="95" Height="40"/>

    </Grid>
</Page>
